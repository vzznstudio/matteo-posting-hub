# Postgres connection (Easypanel > Postgres service > Internal connection URL)
DATABASE_URL=postgres://postgres:CHANGE_ME@matteo-hub_db:5432/matteo-hub

# Public URL of this panel (Postforme downloads media from here)
APP_URL=https://matteopostinghub.vzzn.studio

# Login password for the panel, and a long random secret for session cookies
ADMIN_PASSWORD=change-me
SESSION_SECRET=generate-64-random-chars

# Postiz (Instagram, Facebook Page, YouTube)
POSTIZ_API_URL=https://matteopostiz.vzzn.studio/api/public/v1
POSTIZ_API_KEY=

# Postforme (TikTok)
POSTFORME_API_URL=https://api.postforme.dev/v1
POSTFORME_API_KEY=

# Where uploaded files live (mount an Easypanel volume here)
UPLOAD_DIR=/data/uploads
